/dts-v1/;

/* NOTE: different package type, but otherwise same SoC */
#include <renesas/ra/ra6/r7fa6m5bh3cfc.dtsi>

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/led/led.h>

#include "sparkfun_thing_plus_ra6m5-pinctrl.dtsi"

/ {
	model = "Sparkfun Thing Plus - RA6M5";
	compatible = "renesas,ra6m5", "renesas,ra";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash-controller = &flash1;
		zephyr,code-partition = &code_partition;
		zephyr,flash = &flash0;
		zephyr,console = &uart3;
		zephyr,shell-uart = &uart3;
		zephyr,entropy = &trng;
		zephyr,bt-hci = &bt_hci_uart;
		zephyr,led-strip = &rgb_led;
	};

	leds {
		compatible = "gpio-leds";

		led0: led0 {
			gpios = <&ioport1 6 GPIO_ACTIVE_LOW>;
			label = "Status";
		};
	};

	rgb_led: ws2812 {
		compatible = "worldsemi,ws2812-gpio";
		gpios = <&ioport1 5 0>;
		chain-length = <1>;
		color-mapping = <LED_COLOR_ID_GREEN
				LED_COLOR_ID_RED
				LED_COLOR_ID_BLUE>;
		reset-delay = <50>;
	};

	gpio_keys {
		compatible = "gpio-keys";

		user_button: button {
			gpios = <&ioport4 15 GPIO_ACTIVE_LOW>;
			label = "User";
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	aliases {
		led0 = &led0;
		sw0 = &user_button;
	};
};

/* On-chip flash */

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 DT_SIZE_K(64)>;
			read-only;
		};

		code_partition: partition@10000 {
			label = "image-0";
			reg = <0x00010000 (DT_SIZE_M(2) - DT_SIZE_K(64))>;
		};
	};
};

&flash1 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		storage_partition: partition@0 {
			label = "storage";
			reg = <0X0 DT_SIZE_K(8)>;
		};
	};
};

