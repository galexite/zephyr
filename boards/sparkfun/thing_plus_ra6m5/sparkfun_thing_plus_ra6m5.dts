/* U(S)ART */

&sci3 {
	pinctrl-0 = <&sci3_default>;
	pinctrl-names = "default";
	status = "okay";

	uart3: uart {
		current-speed = <115200>;
		status = "okay";
	};
};

&sci9 {
	pinctrl-0 = <&sci9_default>;
	pinctrl-names = "default";
	status = "okay";

	uart9: uart {
		current-speed = <57600>;
		status = "okay";
		hw-flow-control;

		bt_hci_uart: bt_hci_uart {
			compatible = "zephyr,bt-hci-uart";
			status = "okay";

			esp32 {
				compatible = "renesas,bt-hci-da1453x";
				status = "okay";
				reset-gpios = <&ioport1 15 GPIO_ACTIVE_LOW>;
				reset-assert-duration-ms = <100>;
				boot-duration-ms = <2000>;
			};
		};
	};
};

/* I2C */

&iic0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	interrupts = <87 1>, <88 1>, <89 1>, <90 1>;
	interrupt-names = "rxi", "txi", "tei", "eri";
	clock-frequency = <DT_FREQ_M(1)>;
	pinctrl-0 = <&iic0_default>;
	pinctrl-names = "default";

	/* Fuel guage */
	max17048: max17048@36 {
		compatible = "maxim,max17048";
		reg = <0x36>;
		status = "okay";
	};
};

&iic1 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	interrupts = <91 1>, <92 1>, <93 1>, <94 1>;
	interrupt-names = "rxi", "txi", "tei", "eri";
	clock-frequency = <DT_FREQ_M(1)>;
	pinctrl-0 = <&iic1_default>;
	pinctrl-names = "default";
};

/* SPI */

&spi1 {
	status = "okay";
	pinctrl-0 = <&spi1_default>;
	pinctrl-names = "default";
	clock-frequency = <DT_FREQ_M(5)>;
	cs-gpios = <&ioport1 3 GPIO_ACTIVE_LOW>,
		   <&ioport1 4 GPIO_ACTIVE_LOW>;

	esp_hosted@1 {
		status = "okay";
		compatible = "espressif,esp-hosted";
		reg = <0x1>;
		spi-max-frequency = <DT_FREQ_M(5)>;
		reset-gpios = <&ioport8 4 GPIO_ACTIVE_HIGH>;
		handshake-gpios = <&ioport8 6 GPIO_ACTIVE_HIGH>;
		dataready-gpios = <&ioport8 3 GPIO_ACTIVE_HIGH>;
	};
};


/* ADC */

&adc0 {
	status = "okay";
	pinctrl-0 = <&adc0_default>;
	pinctrl-names = "default";
};

/* microSD card slot */

&sdhc0 {
	status = "okay";
	compatible = "renesas,ra-sdhc";

	channel = 0;
	pinctrl-0 = <&sdhi0_default>;
	pinctrl-names = "default";
	enable-gpios = <&ioport7 8 GPIO_ACTIVE_LOW>;

	/* Features */
	sd-support;
	card-detect;
	write-protect;

	interrupts = <18 12>, <20 12>, <19 12>;
  	interrupt-names = "accs", "card", "dma-req";

	sdmmc {
		compatible = "zephyr,sdmmc-disk";
		disk-name = "SD";
		status = "okay";
	};
};

/* System */

&trng {
	status = "okay";
};

&ioport0 {
	status = "okay";
};

&ioport1 {
	status = "okay";
};

&ioport2 {
	status = "okay";
};

&ioport3 {
	status = "okay";
};

&ioport4 {
	status = "okay";
};

&ioport5 {
	status = "okay";
};

&ioport6 {
	status = "okay";
};

&ioport7 {
	status = "okay";
};

&ioport8 {
	status = "okay";
};

&ioport9 {
	status = "okay";
};

&ioporta {
	status = "okay";
};

&ioportb {
	status = "okay";
};

&xtal {
	clock-frequency = <DT_FREQ_M(24)>;
	mosel = <0>;
	#clock-cells = <0>;
	status = "okay";
};

&subclk {
	status = "okay";
};

&pll {
	clocks = <&xtal>;
	div = <3>;
	mul = <25 0>;
	status = "okay";
};

/* USB */

&usbhs {
	pinctrl-0 = <&usbhs_default>;
	pinctrl-names = "default";
	maximum-speed = "high-speed";
	status = "okay";

	zephyr_udc0: udc {
		status = "okay";

		board_cdc_acm_uart: board_cdc_acm_uart {
			compatible = "zephyr,cdc-acm-uart";
		};
	};
};

&usbhs_phy {
	phys-clock-src = "xtal";
};

/* Miscellaneous */

&option_setting_ofs0 {
	status = "disabled";
};

&option_setting_dualsel {
	status = "disabled";
};

&option_setting_ofs1_sec {
	status = "disabled";
};

&option_setting_banksel_sec {
	status = "disabled";
};

&option_setting_bps_sec {
	status = "disabled";
};

&option_setting_pbps_sec {
	status = "disabled";
};

&option_setting_ofs1_sel {
	status = "disabled";
};

&option_setting_banksel_sel {
	status = "disabled";
};

&option_setting_bps_sel {
	status = "disabled";
};
