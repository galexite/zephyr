/* U(S)ART */

&sci3 {
	pinctrl-0 = <&sci3_default>;
	pinctrl-names = "default";
	status = "okay";

	uart3: uart {
		current-speed = <115200>;
		status = "okay";
	};
};

&sci9 {
	pinctrl-0 = <&sci9_default>;
	pinctrl-names = "default";
	status = "okay";

	uart9: uart {
		current-speed = <57600>;
		status = "okay";
		hw-flow-control;

		bt_hci_uart: bt_hci_uart {
			compatible = "zephyr,bt-hci-uart";
			status = "okay";

			esp32 {
				compatible = "renesas,bt-hci-da1453x";
				status = "okay";
				reset-gpios = <&ioport1 15 GPIO_ACTIVE_LOW>;
				reset-assert-duration-ms = <100>;
				boot-duration-ms = <2000>;
			};
		};
	};
};

/* I2C, shared between feather connector and fuel guage */

&iic0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	interrupts = <87 1>, <88 1>, <89 1>, <90 1>;
	interrupt-names = "rxi", "txi", "tei", "eri";
	clock-frequency = <DT_FREQ_M(1)>;
	pinctrl-0 = <&iic0_default>;
	pinctrl-names = "default";

	/* Fuel guage */
	max17048: max17048@36 {
		compatible = "maxim,max17048";
		reg = <0x36>;
		status = "okay";
	};
};

/* SPI */

&spi0 {
	status = "okay";
	pinctrl-0 = <&spi0_default>;
	pinctrl-names = "default";
	clock-frequency = <DT_FREQ_M(5)>;
	cs-gpios = <&ioport1 12 GPIO_ACTIVE_LOW>;
};

/* ADC */

&adc0 {
	status = "okay";
	pinctrl-0 = <&adc0_default>;
	pinctrl-names = "default";
};

