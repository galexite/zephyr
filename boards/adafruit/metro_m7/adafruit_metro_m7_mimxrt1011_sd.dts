/dts-v1/;

#include "adafruit_metro_m7.dts"

/ {
	aliases {
		sdhc0 = &sdhc0;
	};
};

&lpspi1 {
	sdhc0: sdhc@0 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <0>;
		status = "okay";
		spi-max-frequency = <1000000>;
		mmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
			status = "okay";
		};
	};
};
